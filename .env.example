# Core AI
DEEPGRAM_API=your_deepgram_api_key
GEMINI_API=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Meeting and avatar
BOT_NAME=Tom
PUBLIC_BASE_URL=http://localhost:8080
SCREEN_SHARE_ASSET_BASE_URL=https://spiked.ai
RECALL_API_KEY=your_recall_api_key
RECALL_WEBHOOK_SECRET=whsec_your_workspace_verification_secret
RECALL_WEBHOOK_URL=https://recall-backend-production-409019309412.us-central1.run.app/webhook/recall/transcript
LIVEAVATAR_API_KEY=your_liveavatar_api_key
LIVEAVATAR_API_URL=https://api.liveavatar.com
LIVEAVATAR_AVATAR_ID=69cf601f-b35b-4d1b-a701-c854d223b5a5
LIVEAVATAR_SANDBOX=false

# Backend services
SPIKED_BACKEND_URL=https://spikedai-production-application-409019309412.us-central1.run.app
RAG_BACKEND_URL=https://feat-fastembeddings-cowwwkwqaq-uc.a.run.app
MCP_SERVER_URL=

# Turn-taking
AGENT_BARGE_IN_MS=700
AGENT_ENDPOINTING_MS=500
AGENT_UTTERANCE_END_MS=1000
AGENT_MAX_REPLY_WORDS=45

# Runtime and logging
ENABLE_APP_LOGS=false
APP_LOG_DIR=logs
MEMORY_WRITE_FLUSH_TIMEOUT_S=2.0
AGENT_MEMORY_READY_TIMEOUT_S=1.5
AGENT_WARM_READY_TIMEOUT_S=2.0

# Provider defaults
DEFAULT_VIDEO_PROVIDER=liveavatar
DEFAULT_TTS_PROVIDER=
DEFAULT_ANSWER_ENGINE=spiked

