DEEPGRAM_API=your_deepgram_api_key
GEMINI_API=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
BOT_NAME="Tiya"

# Simli AI avatar renderer (free plan: $10 signup credit + 50 min/month top-up).
# Get the API key + a face ID from https://app.simli.com
SIMLI_API_KEY=your_simli_api_key
SIMLI_FACE_ID=your_simli_face_id
SIMLI_API_URL=https://api.simli.ai
SIMLI_MAX_SESSION_SECONDS=1800
SIMLI_MAX_IDLE_SECONDS=300

# Cartesia TTS (free plan). Get the API key + voice ID from https://play.cartesia.ai
# Output is pinned to raw PCM16 @ 16kHz for Simli.
CARTESIA_API_KEY=your_cartesia_api_key
CARTESIA_VOICE_ID=your_cartesia_voice_id
CARTESIA_MODEL=sonic-3.5
CARTESIA_SAMPLE_RATE=16000

RECALL_API_KEY=your_recall_api_key
# Leave blank to use the per-run token fallback (works without Recall config).
# If set, it must match Recall's workspace verification secret (whsec_...) for
# Svix-style HMAC verification of the realtime websocket upgrade.
RECALL_WEBHOOK_SECRET=
SPIKED_BACKEND_URL=https://spikedai-production-application-409019309412.us-central1.run.app
RECALL_WEBHOOK_URL=https://recall-backend-production-409019309412.us-central1.run.app/webhook/recall/transcript
PUBLIC_BASE_URL=http://localhost:8080
AGENT_BARGE_IN_MS=700
AGENT_ENDPOINTING_MS=500
AGENT_UTTERANCE_END_MS=1000
AGENT_MAX_REPLY_WORDS=45

