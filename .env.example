DEEPGRAM_API=your_deepgram_api_key
GEMINI_API=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
BOT_NAME="Tom"
LIVEAVATAR_API_KEY=your_liveavatar_api_key
LIVEAVATAR_API_URL=https://api.liveavatar.com
LIVEAVATAR_AVATAR_ID=69cf601f-b35b-4d1b-a701-c854d223b5a5
LIVEAVATAR_SANDBOX=false
RECALL_API_KEY=your_recall_api_key
RECALL_WEBHOOK_SECRET=whsec_your_workspace_verification_secret
SPIKED_BACKEND_URL=https://spikedai-production-application-409019309412.us-central1.run.app
RECALL_WEBHOOK_URL=https://recall-backend-production-409019309412.us-central1.run.app/webhook/recall/transcript
PUBLIC_BASE_URL=http://localhost:8080
AGENT_BARGE_IN_MS=700
AGENT_ENDPOINTING_MS=500
AGENT_UTTERANCE_END_MS=1000
AGENT_MAX_REPLY_WORDS=45

# --- Provider selection -----------------------------------------------------
# Fallbacks only. A run that names its providers on /start (video_provider,
# tts_provider, answer_engine) ignores these entirely.
DEFAULT_VIDEO_PROVIDER=liveavatar   # liveavatar | anam | simli
DEFAULT_TTS_PROVIDER=               # cartesia; required only for simli
DEFAULT_ANSWER_ENGINE=spiked        # spiked | anam_native

# --- Anam (video; optionally also the brain) --------------------------------
ANAM_API_KEY=
ANAM_AVATAR_ID=
ANAM_VOICE_ID=
ANAM_AVATAR_MODEL=cara-4-latest
ANAM_REGION=us
ANAM_MAX_SESSION_SECONDS=1800
# Only for answer_engine=anam_native. Leaving this empty while asking for
# native mode fails at session creation rather than starting a mute avatar.
ANAM_NATIVE_LLM_ID=

# --- Simli (video only; must be paired with a TTS provider) -----------------
SIMLI_API_KEY=
SIMLI_FACE_ID=
SIMLI_API_URL=https://api.simli.ai
SIMLI_MAX_SESSION_SECONDS=1800
SIMLI_MAX_IDLE_SECONDS=300
SIMLI_AUDIO_CHUNK_BYTES=6000

# --- Cartesia (TTS) ---------------------------------------------------------
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=f786b574-daa5-4673-aa0c-cbe3e8534c02
CARTESIA_MODEL=sonic-3.5
CARTESIA_SAMPLE_RATE=16000
